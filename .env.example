APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/app.db

# Use mock for local demos; set deepseek plus a real key in the deployment platform.
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_SCHEMA_RETRY=1

# Comma-separated frontend origins allowed to call the backend API.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Usually provided by the deployment platform and consumed by the backend start command.
PORT=8000
